# Origem exata usada no navegador. Em produção, HTTPS e domínio real.
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Gere um segredo aleatório com pelo menos 32 caracteres. Nunca envie .env.local ao Git.
AUTH_SECRET=

# Produção: URL PostgreSQL Neon com TLS; não configure DATABASE_MODE=local na Vercel.
DATABASE_URL=
DATABASE_MODE=local
LOCAL_DATABASE_PATH=.data/vieira

# Somente bootstrap do primeiro administrador. Remova ADMIN_PASSWORD após o cadastro.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Proxy próprio confiável que sobrescreve X-Forwarded-For. A Vercel é detectada automaticamente.
TRUST_PROXY=0

# Integração de object storage opcional; configure o adaptador antes de habilitar uploads.
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_URL=
